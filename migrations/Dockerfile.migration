FROM flyway/flyway:latest

# Source directory containing this module's SQL migrations, relative to the
# build context. The image-build workflow passes the per-module path
# (e.g. src/Auth/db/migrations) so the Dockerfile stays decoupled from
# the on-disk module layout.
ARG MIGRATIONS_DIR
COPY ${MIGRATIONS_DIR}/ /flyway/sql/

# Copy the entrypoint script
COPY migrations/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
