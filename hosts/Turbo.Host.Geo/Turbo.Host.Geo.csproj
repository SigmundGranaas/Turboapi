<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Turbo.Host.Geo</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Turboapi-geo\Turboapi-geo.csproj" />
    <ProjectReference Include="..\..\src\Shared\Turbo.Messaging.Nats\Turbo.Messaging.Nats.csproj" />
    <ProjectReference Include="..\..\TurboAuthentication\TurboAuthentication.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\Turboapi-geo\appsettings.json" Link="appsettings.json" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\Turboapi-geo\appsettings.json')" />
    <Content Include="..\..\Turboapi-geo\appsettings.Development.json" Link="appsettings.Development.json" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\Turboapi-geo\appsettings.Development.json')" />
    <Content Include="..\..\Turboapi-geo\appsettings.Test.json" Link="appsettings.Test.json" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\Turboapi-geo\appsettings.Test.json')" />
  </ItemGroup>

</Project>
